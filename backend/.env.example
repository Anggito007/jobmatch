# Environment variables — salin ke `.env` dan isi bila perlu.
# Untuk MVP, semua punya default yang jalan tanpa konfigurasi.

# Database (default SQLite; nanti ganti ke Postgres/Neon saat deploy)
DATABASE_URL=sqlite:///./jobmatch.db

# CORS origins (pisahkan dengan koma). Tambahkan URL frontend Vercel.
# CORS_ORIGINS=http://localhost:3000

# Interval fetch scheduler (jam)
FETCH_INTERVAL_HOURS=6

# Lama sesi login (hari)
SESSION_TTL_DAYS=30

# Email digest (Gmail SMTP). Kosongkan untuk nonaktifkan pengiriman.
# SMTP_PASSWORD harus App Password Gmail (Settings → Security → App Passwords),
# BUKAN password login biasa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM=
DIGEST_RECIPIENTS=
